      <!-- HERO SECTION (trust + new number) -->
      <section class="mb-20 relative">
        <div class="absolute -top-20 -right-20 w-80 h-80 bg-[#00ff9d]/5 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10">
