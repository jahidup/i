  </main>

  <!-- MODAL (same structure, number updated) -->
  <div id="serviceModal" class="fixed inset-0 modal-overlay hidden items-center justify-center z-50 transition-all" style="background: rgba(0,0,0,0.8); backdrop-filter: blur(10px);">
    <div class="bg-[#0f1a1f] border border-[#00ff9d]/50 rounded-xl w-11/12 max-w-md p-6 shadow-2xl shadow-[#00ff9d]/20 relative glass-card">
      <button id="closeModalBtn" class="absolute top-4 right-4 text-gray-400 hover:text-[#00ff9d] text-2xl">&times;</button>
      <div class="mb-5">
        <div class="flex items-center gap-3 border-b border-[#00ff9d]/30 pb-3">
          <i class="fas fa-cube text-[#00ff9d] text-2xl"></i>
          <h3 id="modalServiceName" class="text-xl font-bold text-[#00ff9d]">Service name</h3>
        </div>
        <p id="modalDescription" class="text-gray-300 my-4 text-sm leading-relaxed">description</p>
        <div class="bg-black/40 p-4 rounded-md border border-[#00ff9d]/20 font-mono text-sm">
          <div class="flex justify-between"><span class="text-gray-400">processing:</span><span id="modalProcessing" class="text-[#00ff9d]">Automated</span></div>
          <div class="flex justify-between mt-2"><span class="text-gray-400">status:</span><span id="modalBadge" class="text-[#00ff9d] border border-[#00ff9d]/30 px-2 rounded">Instant</span></div>
        </div>
      </div>
      <a id="modalWhatsAppBtn" href="https://wa.me/12183101130?text=Hello%2C%20I'm%20interested%20in%20PRO%20services." target="_blank" class="block w-full bg-[#00ff9d] hover:bg-[#00dd88] text-black font-semibold text-center py-3 rounded-md transition mt-2 flex items-center justify-center gap-2"><i class="fab fa-whatsapp"></i> Proceed via WhatsApp</a>
    </div>
  </div>

  <script>
    (function() {
      // ---------- SERVICES DATASET (22 items) ----------
      const services = [
        { name: "SIM Owner Details", icon: "sim-card", description: "Instant SIM subscriber information.", badge: "Instant", proc: "Automated" },
        { name: "Aadhaar to PAN", icon: "id-card", description: "Instant PAN card lookup from Aadhaar.", badge: "Instant", proc: "Automated" },
        { name: "Ration Card to Aadhaar", icon: "utensils", description: "Retrieve Aadhaar from ration card details.", badge: "Instant", proc: "Automated" },
        { name: "PAN to Masked Aadhaar", icon: "eye-slash", description: "Generate masked Aadhaar from PAN.", badge: "Instant", proc: "Automated" },
        { name: "Vehicle to RC PDF", icon: "car", description: "Download RC PDF from vehicle number.", badge: "Instant", proc: "Automated" },
        { name: "Voter Mobile Link", icon: "mobile-alt", description: "Link mobile number to voter ID.", badge: "Secure", proc: "Assisted" },
        { name: "Voter PDF without OTP", icon: "file-pdf", description: "Get voter PDF instantly without OTP.", badge: "Instant", proc: "Automated" },
        { name: "Ration Family Details", icon: "users", description: "Retrieve family details from ration card.", badge: "Automated", proc: "Automated" },
        { name: "PM KISAN Land Seeding", icon: "tractor", description: "Check PM KISAN land seeding status.", badge: "Secure", proc: "Assisted" },
        { name: "Mobile to Full Info", icon: "phone", description: "Get comprehensive details from mobile number.", badge: "Instant", proc: "Automated" },
        { name: "UPI/QR to Bank Details", icon: "qrcode", description: "Extract bank details from UPI/QR.", badge: "Instant", proc: "Automated" },
        { name: "PAN to Aadhaar (NSDL)", icon: "exchange-alt", description: "Find Aadhaar from PAN without OTP.", badge: "Instant", proc: "Automated" },
        { name: "New PAN with Documents", icon: "file-alt", description: "Apply for new PAN with document upload.", badge: "Assisted", proc: "Assisted" },
        { name: "New PAN without Documents", icon: "file", description: "Second PAN application without documents.", badge: "Assisted", proc: "Assisted" },
        { name: "Mobile to Address", icon: "address-card", description: "Instant address lookup from mobile number.", badge: "Instant", proc: "Automated" },
        { name: "OTT Subscriptions", icon: "tv", description: "Cheapest OTT platform subscriptions.", badge: "Automated", proc: "Automated" },
        { name: "Bank Account on Your Number", icon: "money-check", description: "Assisted bank account setup.", badge: "Assisted", proc: "Assisted" },
        { name: "Mobile to All Info", icon: "info-circle", description: "Complete details from mobile number.", badge: "Instant", proc: "Automated" },
        { name: "All Services Available", icon: "cogs", description: "Comprehensive digital intelligence services.", badge: "24/7", proc: "Assisted" },
        { name: "GST to PAN/Mobile", icon: "file-invoice", description: "Retrieve PAN and mobile from GST.", badge: "Instant", proc: "Automated" },
        { name: "Fampay to Mobile", icon: "mobile", description: "Get mobile number from Fampay details.", badge: "Instant", proc: "Automated" },
        { name: "Telegram to Mobile", icon: "paper-plane", description: "Find mobile number from Telegram username.", badge: "Instant", proc: "Automated" }
      ];

      // ---------- RENDER CARDS ----------
      const grid = document.getElementById('services-grid');
      function renderCards() {
        grid.innerHTML = '';
        services.forEach((s, index) => {
          const card = document.createElement('div');
          card.className = 'glass-card rounded-xl p-5 cursor-pointer transition-all hover:scale-[1.02] flex flex-col';
          card.setAttribute('data-index', index);
          card.innerHTML = `
            <div class="flex items-start justify-between">
              <i class="fas fa-${s.icon} text-3xl text-[#00ff9d]"></i>
              <span class="text-xs font-mono border border-[#00ff9d]/40 px-2 py-0.5 rounded-full text-[#a0f0d0]">${s.badge}</span>
            </div>
            <h3 class="text-lg font-semibold mt-4 text-white">${s.name}</h3>
            <p class="text-xs text-gray-400 mt-1 leading-relaxed flex-1">${s.description}</p>
            <div class="mt-4 text-[#00ff9d] text-xs flex items-center gap-2">
              <span class="w-2 h-2 bg-[#00ff9d] rounded-full animate-pulse"></span> ${s.proc} workflow
            </div>
          `;
          card.addEventListener('click', () => openModal(index));
          grid.appendChild(card);
        });
      }
      renderCards();

      // ---------- MODAL ----------
      const modal = document.getElementById('serviceModal');
      const closeModalBtn = document.getElementById('closeModalBtn');
      const modalName = document.getElementById('modalServiceName');
      const modalDesc = document.getElementById('modalDescription');
      const modalProc = document.getElementById('modalProcessing');
      const modalBadge = document.getElementById('modalBadge');
      const modalWhatsApp = document.getElementById('modalWhatsAppBtn');

      function openModal(index) {
        const s = services[index];
        modalName.innerText = s.name;
        modalDesc.innerText = s.description;
        modalProc.innerText = s.proc;
        modalBadge.innerText = s.badge;
        modalWhatsApp.href = `https://wa.me/12183101130?text=Hello%2C%20I'm%20interested%20in%20${encodeURIComponent(s.name)}.%20Please%20guide%20me.`;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = 'auto';
      }

      closeModalBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal(); });

      // ---------- TYPING ANIMATION ----------
      const typeEl = document.getElementById('typewriter');
      const phrases = ['Live intelligence feed', '22 modules online', 'Instant verification', 'PRO support 24/7'];
      let phraseIndex = 0, charIndex = 0, isDeleting = false, currentText = '';
      function typeEffect() {
        const fullText = phrases[phraseIndex];
        if (isDeleting) {
          currentText = fullText.substring(0, charIndex - 1);
          charIndex--;
        } else {
          currentText = fullText.substring(0, charIndex + 1);
          charIndex++;
        }
        typeEl.innerText = currentText;
        if (!isDeleting && charIndex === fullText.length) {
          isDeleting = true;
          setTimeout(typeEffect, 2000);
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          setTimeout(typeEffect, 300);
        } else {
          const speed = isDeleting ? 40 : 100;
          setTimeout(typeEffect, speed);
        }
      }
      setTimeout(typeEffect, 500);

      // ---------- SIDEBAR TOGGLE (with close button and overlay) ----------
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('sidebarOverlay');
      const menuToggle = document.getElementById('menuToggle');
      const closeSidebarBtn = document.getElementById('closeSidebarBtn');

      function openSidebar() {
        sidebar.classList.remove('-translate-x-full');
        sidebar.classList.add('translate-x-0');
        overlay.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
      function closeSidebar() {
        sidebar.classList.add('-translate-x-full');
        sidebar.classList.remove('translate-x-0');
        overlay.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }

      if (menuToggle) menuToggle.addEventListener('click', openSidebar);
      if (closeSidebarBtn) closeSidebarBtn.addEventListener('click', closeSidebar);
      overlay.addEventListener('click', closeSidebar);

      // ensure sidebar hidden on mobile resize
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
          sidebar.classList.remove('-translate-x-full', 'translate-x-0');
          sidebar.classList.add('md:translate-x-0');
          overlay.classList.add('hidden');
          document.body.style.overflow = 'auto';
        } else {
          sidebar.classList.add('-translate-x-full');
          sidebar.classList.remove('translate-x-0', 'md:translate-x-0');
        }
      });

      // explore modules button scrolls to grid
      document.getElementById('exploreModulesBtn')?.addEventListener('click', () => {
        document.getElementById('services-grid').scrollIntoView({ behavior: 'smooth' });
      });

    })();
  </script>
  <noscript>JavaScript enabled for dynamic interface</noscript>
</body>
</html>
