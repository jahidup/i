      <!-- SERVICES GRID (22 modules) -->
      <section class="mb-24">
        <div class="flex items-center gap-3 mb-8 border-b border-[#00ff9d]/20 pb-4">
          <h2 class="text-2xl md:text-3xl font-semibold text-[#00ff9d]">◉ INTELLIGENCE MODULES</h2>
          <span class="text-xs bg-[#00ff9d]/20 text-[#a7f0d0] px-3 py-1 rounded-full border border-[#00ff9d]/30">22 ACTIVE</span>
        </div>
        <div id="services-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 auto-rows-fr">
