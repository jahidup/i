  <style>
    * { font-family: 'Inter', 'Roboto Mono', monospace; }
    body {
      background: #0b0f12;
      background-image: radial-gradient(circle at 15% 30%, rgba(0, 255, 157, 0.04) 0%, transparent 30%),
                        radial-gradient(circle at 80% 70%, rgba(0, 180, 255, 0.04) 0%, transparent 35%);
      color: #eef5ff;
      overflow-x: hidden;
    }
    /* smooth glassmorphism */
    .glass {
      background: rgba(18, 28, 32, 0.4);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(0, 255, 157, 0.1);
    }
    .glass-card {
      background: rgba(12, 22, 26, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(0, 255, 157, 0.15);
      transition: all 0.25s ease;
    }
    .glass-card:hover {
      border-color: #00ff9d;
      box-shadow: 0 12px 30px -8px rgba(0, 255, 157, 0.25);
      transform: translateY(-3px);
    }
    /* glow text */
    .glow {
      text-shadow: 0 0 8px rgba(0, 255, 157, 0.6);
    }
    /* custom scrollbar */
    ::-webkit-scrollbar { width: 4px; }
    ::-webkit-scrollbar-track { background: #142026; }
    ::-webkit-scrollbar-thumb { background: #00ff9d; border-radius: 20px; }
    /* typing cursor */
    .typed-cursor {
      display: inline-block;
      width: 0.6rem;
      height: 1.2rem;
      background-color: #00ff9d;
      margin-left: 4px;
      animation: blink 1s step-end infinite;
    }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    /* sidebar animation */
    .sidebar-slide {
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    /* trust badge pulse */
    .pulse-dot {
      box-shadow: 0 0 0 0 rgba(0, 255, 157, 0.6);
      animation: pulse 2s infinite;
    }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(0,255,157,0.6); } 70% { box-shadow: 0 0 0 10px rgba(0,255,157,0); } 100% { box-shadow: 0 0 0 0 rgba(0,255,157,0); } }
  </style>
</head>
<body class="min-h-screen antialiased flex">

