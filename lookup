      <!-- FOOTER (updated number) -->
      <footer class="border-t border-[#00ff9d]/20 pt-10 pb-6 text-sm text-gray-400 flex flex-col md:flex-row justify-between items-center gap-4">
        <div>© 2025 CYBERINTEL PRO — <span class="text-[#00ff9d]">end-to-end encrypted</span></div>
        <div class="flex gap-6">
