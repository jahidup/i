          <a href="https://wa.me/12183101130" target="_blank" class="hover:text-[#00ff9d] text-xl"><i class="fab fa-whatsapp"></i></a>
          <a href="#" class="hover:text-[#00ff9d] text-xl"><i class="fab fa-github"></i></a>
